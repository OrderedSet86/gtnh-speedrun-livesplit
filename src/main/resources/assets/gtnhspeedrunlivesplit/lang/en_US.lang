gtnhspeedrunlivesplit.chat.prefix=[LiveSplit]
gtnhspeedrunlivesplit.chat.line=%s %s
commands.gtnhspeedrunlivesplit.usage=/livesplit <export|milestones [page]|route [page]>
gtnhspeedrunlivesplit.export.no_splits=No splits from this server yet. The server needs GTNH Speedrun LiveSplit and the audit mod, of the same version as yours.
gtnhspeedrunlivesplit.export.written=Splits file written: %s
gtnhspeedrunlivesplit.export.import_hint=Open it in LiveSplit (Open Splits) or LiveSplit One (Splits, Import) before your first run. It has no times yet.
gtnhspeedrunlivesplit.export.failed=Can't write the splits file: %s
gtnhspeedrunlivesplit.export.icons_unknown=No icon for items this client doesn't have: %s
gtnhspeedrunlivesplit.export.icons_failed=No icon for items that failed to draw (see the log): %s
gtnhspeedrunlivesplit.export.no_framebuffer=No icons: drawing them needs Video Settings, Enable FBOs.
gtnhspeedrunlivesplit.list.no_catalog=No milestones from this server yet. The server needs GTNH Speedrun LiveSplit and the audit mod, of the same version as yours.
gtnhspeedrunlivesplit.milestones.header=Milestones, page %s of %s. Put ids in config/gtnhspeedrunlivesplit-mysplits.json to pick your segments.
gtnhspeedrunlivesplit.milestones.reached=%s: %s, reached at %s
gtnhspeedrunlivesplit.milestones.unreached=%s: %s, not reached
gtnhspeedrunlivesplit.route.header=Your route, page %s of %s
gtnhspeedrunlivesplit.route.reached=%s. %s, reached at %s
gtnhspeedrunlivesplit.route.unreached=%s. %s, %s of %s milestones reached
gtnhspeedrunlivesplit.route.rejected=Your route file can't be read, so no segment splits on this server: %s
gtnhspeedrunlivesplit.route.unknown_ids=Your route names milestones this server doesn't have, and those segments are left out: %s
